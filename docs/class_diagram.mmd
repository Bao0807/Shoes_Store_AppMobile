classDiagram
    direction TB

    class User {
        +String uid
        +String fullName
        +String email
        +String phone
        +String avatarUrl
        +String preferredSize
        +String runningGoal
        +String role
        +List~String~ recentSearches
        +Timestamp createdAt
        +Timestamp updatedAt
    }

    class Address {
        +String addressId
        +String userId
        +String receiverName
        +String phone
        +String addressDetail
        +String label
        +boolean isDefault
    }

    class Banner {
        +String bannerId
        +String badge
        +String title
        +String subtitle
        +String ctaLabel
        +String targetCategory
        +String imageUrl
        +int displayOrder
        +boolean isActive
    }

    class Product {
        +String productId
        +String name
        +String brand
        +String category
        +long price
        +long originalPrice
        +double ratingAvg
        +int reviewCount
        +String thumbnailUrl
        +List~String~ galleryUrls
        +String weightGrams
        +String heelDropMm
        +String cushionLevel
        +String surfaceType
        +String description
        +boolean isActive
        +Timestamp createdAt
        +hasDiscount() boolean
        +getDiscountPercent() int
    }

    class ProductVariant {
        +String variantId
        +String productId
        +String colorName
        +String colorHex
        +String imageUrl
        +String size
        +int stockQty
        +String sku
        +isInStock() boolean
        +hasEnoughStock(int qty) boolean
    }

    class Review {
        +String reviewId
        +String productId
        +String userId
        +String orderId
        +String reviewerName
        +String reviewerAvatarUrl
        +float rating
        +String comment
        +Timestamp createdAt
    }

    class WishlistItem {
        +String productId
        +String userId
        +Timestamp addedAt
    }

    class CartItem {
        +String cartItemId
        +String userId
        +String productId
        +String variantId
        +String size
        +String colorName
        +int quantity
        +boolean selected
        +Timestamp updatedAt
    }

    class Voucher {
        +String code
        +String shortBadge
        +String title
        +String description
        +long discountAmount
        +long minOrderAmount
        +int usageLimit
        +int usedCount
        +Timestamp expiryDate
        +boolean isActive
        +isEligible(long subtotal) boolean
        +hasRemainingQuota() boolean
    }

    class Order {
        +String orderId
        +String orderCode
        +String userId
        +OrderStatus status
        +PaymentMethod paymentMethod
        +String receiverName
        +String receiverPhone
        +String shippingAddress
        +String shippingMethod
        +String voucherCode
        +long subtotal
        +long shippingFee
        +long discount
        +long total
        +Timestamp createdAt
        +Timestamp updatedAt
        +getTotalQuantity() int
        +canCancel() boolean
    }

    class OrderItem {
        +String productId
        +String variantId
        +String productName
        +String thumbnailUrl
        +String size
        +String colorName
        +long unitPrice
        +int quantity
        +long lineTotal
    }

    class Payment {
        +String paymentId
        +String orderId
        +String userId
        +PaymentMethod method
        +PaymentStatus status
        +long amount
        +String transactionCode
        +Timestamp paidAt
        +Timestamp createdAt
        +isPaid() boolean
    }

    class Notification {
        +String notificationId
        +String userId
        +String title
        +String message
        +NotificationType type
        +String targetId
        +boolean unread
        +Timestamp createdAt
    }

    class OrderStatus {
        <<enumeration>>
        PENDING
        SHIPPING
        COMPLETED
        CANCELLED
    }

    class PaymentMethod {
        <<enumeration>>
        COD
        BANK_QR
        E_WALLET
    }

    class PaymentStatus {
        <<enumeration>>
        UNPAID
        PAID
        FAILED
        REFUNDED
    }

    class NotificationType {
        <<enumeration>>
        ORDER
        PROMO
        DROP
    }

    User "1" *-- "0..*" Address : sở hữu
    User "1" *-- "0..*" WishlistItem : lưu yêu thích
    User "1" *-- "0..*" CartItem : giỏ hàng
    User "1" *-- "0..*" Notification : nhận thông báo
    User "1" --> "0..*" Order : đặt hàng
    User "1" --> "0..*" Review : viết đánh giá

    Product "1" *-- "1..*" ProductVariant : biến thể màu/size
    Product "1" *-- "0..*" Review : có đánh giá

    WishlistItem "0..*" --> "1" Product : tham chiếu
    CartItem "0..*" --> "1" Product : chọn giày
    CartItem "0..*" --> "1" ProductVariant : chọn size/màu

    Order "1" *-- "1..*" OrderItem : gồm các mục
    Order "1" --> "1..*" Payment : thanh toán
    Order "0..*" --> "0..1" Voucher : áp dụng mã
    Order ..> OrderStatus : trạng thái
    Order ..> PaymentMethod : lưu nhanh phương thức
    OrderItem "0..*" --> "1" Product : snapshot từ

    Payment ..> PaymentMethod : phương thức
    Payment ..> PaymentStatus : trạng thái

    Notification ..> NotificationType : phân loại
    Banner "0..*" ..> "0..*" Product : lọc theo targetCategory
