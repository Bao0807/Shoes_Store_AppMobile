<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/main_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/main_bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_floating_nav_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:padding="4dp">

        <View
            android:id="@+id/nav_sliding_indicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_nav_item_active" />

        <LinearLayout
            android:id="@+id/main_bottom_nav_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_floating_nav_item_ripple">

                <ImageView
                    android:id="@+id/nav_icon_home"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_nav_home" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_wishlist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_floating_nav_item_ripple">

                <ImageView
                    android:id="@+id/nav_icon_wishlist"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_wishlist"
                    android:src="@drawable/ic_nav_wishlist" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_cart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:clipChildren="false"
                android:focusable="true"
                android:foreground="@drawable/bg_floating_nav_item_ripple">

                <ImageView
                    android:id="@+id/nav_icon_cart"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_cart"
                    android:src="@drawable/ic_nav_cart" />

                <TextView
                    android:id="@+id/nav_badge_cart"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/brand_accent"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/text_on_dark"
                    android:textSize="10sp"
                    android:translationX="13dp"
                    android:translationY="-11dp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_notification"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:clipChildren="false"
                android:focusable="true"
                android:foreground="@drawable/bg_floating_nav_item_ripple">

                <ImageView
                    android:id="@+id/nav_icon_notification"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_notification"
                    android:src="@drawable/ic_nav_notification" />

                <TextView
                    android:id="@+id/nav_badge_notification"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/brand_accent"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/text_on_dark"
                    android:textSize="10sp"
                    android:translationX="13dp"
                    android:translationY="-11dp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/bg_floating_nav_item_ripple">

                <ImageView
                    android:id="@+id/nav_icon_profile"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_profile"
                    android:src="@drawable/ic_nav_profile" />
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
