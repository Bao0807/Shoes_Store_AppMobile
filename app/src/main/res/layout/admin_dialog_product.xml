<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/dialog_prod_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_stepper_box"
            android:hint="Tên mẫu giày (vd: Novablast 5)"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialog_prod_brand"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Hãng (Nike, ASICS...)"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <EditText
                android:id="@+id/dialog_prod_category"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Dòng (Daily, Race...)"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialog_prod_price"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Giá bán (VNĐ)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <EditText
                android:id="@+id/dialog_prod_original_price"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Giá gốc (VNĐ)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/dialog_prod_thumb_url"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stepper_box"
            android:hint="Link ảnh HTTPS (để trống dùng ảnh mặc định)"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/dialog_prod_colors"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stepper_box"
            android:hint="Phối màu, cách dấu phẩy (vd: Trắng Cam, Đen)"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialog_prod_sizes"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_stepper_box"
                android:hint="Size EU (39, 40, 41, 42, 43)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/dialog_prod_stock"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Tồn kho / size"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/dialog_prod_desc"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stepper_box"
            android:gravity="top|start"
            android:hint="Mô tả ngắn về giày chạy bộ..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
