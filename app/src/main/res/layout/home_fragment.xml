<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Sticky Header: Avatar + Search Bar + Filter Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/home_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="@string/nav_profile"
            android:focusable="true"
            android:padding="1.5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar_runner"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.ShoesStore.Circle"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1.5dp" />

        <LinearLayout
            android:id="@+id/home_search_bar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_search_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/home_filter_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:contentDescription="@string/filter_title"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_filter"
                app:tint="@color/brand_primary" />

            <View
                android:id="@+id/home_filter_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_accent_soft"
                android:backgroundTint="@color/brand_accent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/home_refresh_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_accent"
        app:trackColor="@color/brand_accent_soft"
        app:trackThickness="2.5dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Banner Carousel -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/home_banner_pager"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="14dp" />

            <LinearLayout
                android:id="@+id/home_banner_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Running Need Category Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_all"
                        style="@style/Widget.ShoesStore.Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/cat_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_daily"
                        style="@style/Widget.ShoesStore.Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cat_daily" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_race"
                        style="@style/Widget.ShoesStore.Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cat_race" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_tempo"
                        style="@style/Widget.ShoesStore.Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cat_tempo" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_trail"
                        style="@style/Widget.ShoesStore.Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cat_trail" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_recovery"
                        style="@style/Widget.ShoesStore.Chip.Category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cat_recovery" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/home_section_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:text="@string/home_section_suggest"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/home_product_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/home_clear_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_clear_filter"
                    android:textColor="@color/brand_accent"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 2-Column Running Shoes Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_shoe_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="11dp" />

            <!-- Empty Filter State -->
            <LinearLayout
                android:id="@+id/home_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_empty_filter"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_empty_reset_btn"
                    style="@style/Widget.ShoesStore.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/filter_reset" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
