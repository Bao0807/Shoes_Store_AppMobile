<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialog_voucher_code"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_stepper_box"
                android:hint="Mã (vd: RUN200K)"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <EditText
                android:id="@+id/dialog_voucher_badge"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Nhãn (vd: -200K)"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/dialog_voucher_title"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stepper_box"
            android:hint="Tiêu đề (vd: Giảm 200.000₫ đơn từ 2.5 triệu)"
            android:inputType="textCapSentences"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <EditText
            android:id="@+id/dialog_voucher_desc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stepper_box"
            android:hint="Mô tả chi tiết ưu đãi"
            android:inputType="textCapSentences"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialog_voucher_discount"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Tiền giảm (VNĐ)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <EditText
                android:id="@+id/dialog_voucher_min_order"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Đơn tối thiểu (VNĐ)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialog_voucher_limit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Giới hạn lượt (vd: 50)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <EditText
                android:id="@+id/dialog_voucher_days"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper_box"
                android:hint="Số ngày hiệu lực (30)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
