<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/wishlist_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/wishlist_count_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/brand_accent_soft"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/brand_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Category Filter -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/wishlist_category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/wl_chip_all"
                style="@style/Widget.ShoesStore.Chip.Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/cat_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/wl_chip_daily"
                style="@style/Widget.ShoesStore.Chip.Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_daily" />

            <com.google.android.material.chip.Chip
                android:id="@+id/wl_chip_race"
                style="@style/Widget.ShoesStore.Chip.Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_race" />

            <com.google.android.material.chip.Chip
                android:id="@+id/wl_chip_tempo"
                style="@style/Widget.ShoesStore.Chip.Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_tempo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/wl_chip_trail"
                style="@style/Widget.ShoesStore.Chip.Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_trail" />

            <com.google.android.material.chip.Chip
                android:id="@+id/wl_chip_recovery"
                style="@style/Widget.ShoesStore.Chip.Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_recovery" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wishlist_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="11dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/wishlist_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_circle_accent_soft">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/brand_accent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/wishlist_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/wishlist_empty_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wishlist_explore_btn"
            style="@style/Widget.ShoesStore.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            android:text="@string/wishlist_explore" />
    </LinearLayout>

</LinearLayout>
